# Response headers. Cloudflare reads this file at deploy time and does not
# serve it. Everything on this site is same-origin: no CDN, no hosted fonts,
# no analytics, no inline script or style. JSON-LD is a data block, which CSP
# does not execute or block.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), clipboard-read=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
